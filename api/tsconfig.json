{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "moduleDetection": "auto",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"]
  },
  "include": [
    "./**/*.ts",
    "../src/income-verification/server/**/*.ts",
    "../src/income-verification/lib/**/*.ts"
  ],
  "exclude": [
    "../src/income-verification/**/__tests__/**",
    "../src/income-verification/**/*.test.ts",
    "../src/income-verification/lib/clientAuth.ts"
  ]
}
