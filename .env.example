# Environment variables

# Existing DSS / Income Verification
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
BLOB_READ_WRITE_TOKEN=
OPENAI_API_KEY=

# Model routing (Income Verification v2)
# Classification / source-normalization / underwriter-summary wording.
# OPENAI_MODEL remains a compatibility fallback for the classification role.
OPENAI_MODEL=
OPENAI_CLASSIFICATION_MODEL=gpt-5.4-mini

# Scanned PDFs, difficult tables, and deterministic-parser fallback.
# Do not use this model for every upload.
OPENAI_VISION_MODEL=gpt-5.6-terra

# Escalation only: Terra failed, Terra did not reconcile, or structure remains ambiguous.
# Do not use Sol for every upload.
OPENAI_ESCALATION_MODEL=gpt-5.6-sol
